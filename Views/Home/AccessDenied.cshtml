@{
    var lang = Context.Request.Cookies["Language"] ?? "ar";
    var isArabic = lang == "ar";
    ViewData["Title"] = isArabic ? "الوصول مرفوض" : "Access Denied";
    Layout = null;
    var userName = User.Identity?.Name ?? "";
    var displayName = userName.Contains("\\") ? userName.Split('\\').Last() : userName;
    var userInitial = !string.IsNullOrEmpty(displayName) ? displayName[0].ToString().ToUpper() : "U";
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(isArabic ? "الوصول مرفوض - نظام السجل المدني" : "Access Denied - Civil Registry System")</title>
    @if (isArabic)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    }
    else
    {
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    }
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --secondary: #64748b;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --danger-dark: #dc2626;
            --dark: #1e293b;
            --light: #f8fafc;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: @(isArabic ? "'Cairo'" : "'Inter'"), sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #1e293b 0%, #334155 50%, #1e293b 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        /* Animated background */
        body::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(239, 68, 68, 0.1) 0%, transparent 50%);
            animation: pulse 15s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* Floating shapes */
        .shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.1;
            animation: float 20s ease-in-out infinite;
        }

        .shape-1 {
            width: 400px;
            height: 400px;
            background: var(--danger);
            top: -100px;
            right: -100px;
            animation-delay: 0s;
        }

        .shape-2 {
            width: 300px;
            height: 300px;
            background: var(--warning);
            bottom: -50px;
            left: -50px;
            animation-delay: -5s;
        }

        .shape-3 {
            width: 200px;
            height: 200px;
            background: var(--primary);
            top: 50%;
            left: 10%;
            animation-delay: -10s;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(10deg); }
        }

        .main-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 520px;
        }

        /* Logo */
        .logo {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            box-shadow: 0 10px 40px rgba(79, 70, 229, 0.4);
        }

        .logo-icon i {
            font-size: 32px;
            color: white;
        }

        .logo h1 {
            color: white;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .logo p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
            margin: 5px 0 0;
        }

        /* Card */
        .card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            border: none;
        }

        .card-body {
            padding: 40px;
        }

        /* Warning Banner */
        .warning-banner {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(239, 68, 68, 0.05) 100%);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 25px;
            text-align: center;
        }

        .warning-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, var(--danger) 0%, var(--danger-dark) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            animation: pulse-icon 2s ease-in-out infinite;
        }

        .warning-icon i {
            font-size: 32px;
            color: white;
        }

        @@keyframes pulse-icon {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .warning-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--danger);
            margin-bottom: 5px;
        }

        .warning-subtitle {
            color: var(--secondary);
            font-size: 0.9rem;
        }

        /* User Info */
        .user-info {
            text-align: center;
            padding: 20px;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-radius: 16px;
            margin-bottom: 25px;
        }

        .user-avatar {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--secondary) 0%, #475569 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
            font-size: 24px;
            font-weight: 700;
            color: white;
        }

        .user-name {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 3px;
        }

        .user-domain {
            font-size: 0.8rem;
            color: var(--secondary);
        }

        .user-role {
            display: inline-block;
            padding: 4px 12px;
            background: rgba(100, 116, 139, 0.1);
            border-radius: 20px;
            font-size: 0.75rem;
            color: var(--secondary);
            margin-top: 10px;
        }

        /* Message */
        .message {
            text-align: center;
            margin-bottom: 25px;
        }

        .message p {
            color: var(--secondary);
            font-size: 0.95rem;
            line-height: 1.7;
        }

        /* Permissions List */
        .permissions-info {
            background: #fefce8;
            border: 1px solid #fef08a;
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 25px;
        }

        .permissions-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: #854d0e;
            margin-bottom: 10px;
        }

        .permissions-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .permissions-list li {
            font-size: 0.85rem;
            color: #a16207;
            padding: 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .permissions-list li i {
            font-size: 0.7rem;
        }

        /* Buttons */
        .btn {
            padding: 14px 28px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 35px rgba(79, 70, 229, 0.4);
            color: white;
        }

        .btn-outline {
            background: transparent;
            color: var(--secondary);
            border: 2px solid #e2e8f0;
        }

        .btn-outline:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: var(--secondary);
        }

        .btn-block {
            width: 100%;
        }

        .btn-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-group .btn {
            flex: 1;
            min-width: 140px;
        }

        /* Contact Admin */
        .contact-admin {
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid #e2e8f0;
            margin-top: 20px;
        }

        .contact-admin p {
            color: var(--secondary);
            font-size: 0.85rem;
            margin-bottom: 8px;
        }

        .contact-admin a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
        }

        .contact-admin a:hover {
            text-decoration: underline;
        }

        /* Copyright */
        .copyright {
            text-align: center;
            margin-top: 30px;
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <!-- Floating shapes -->
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>

    <div class="main-container">
        <!-- Logo -->
        <div class="logo">
            <div class="logo-icon">
                <i class="fas fa-building-columns"></i>
            </div>
            <h1>@(isArabic ? "نظام السجل المدني" : "Civil Registry System")</h1>
            <p>@(isArabic ? "نظام إدارة السجلات المدنية" : "Registry Management System")</p>
        </div>

        <!-- Card -->
        <div class="card">
            <div class="card-body">
                <!-- Warning Banner -->
                <div class="warning-banner">
                    <div class="warning-icon">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                    <h2 class="warning-title">@(isArabic ? "الوصول مرفوض" : "Access Denied")</h2>
                    <p class="warning-subtitle">@(isArabic ? "ليس لديك الصلاحيات اللازمة" : "You don't have the required permissions")</p>
                </div>

                <!-- User Info -->
                <div class="user-info">
                    <div class="user-avatar">@userInitial</div>
                    <div class="user-name">@displayName</div>
                    <div class="user-domain">@userName</div>
                    <span class="user-role">
                        <i class="fas fa-user @(isArabic ? "ms-1" : "me-1")"></i>
                        @(isArabic ? "مستخدم عادي" : "Standard User")
                    </span>
                </div>

                <!-- Message -->
                <div class="message">
                    <p>
                        @(isArabic
                            ? "الصفحة التي تحاول الوصول إليها تتطلب صلاحيات مسؤول. يرجى التواصل مع مسؤول النظام إذا كنت بحاجة إلى الوصول."
                            : "The page you're trying to access requires administrator privileges. Please contact your system administrator if you need access.")
                    </p>
                </div>

                <!-- Permissions Info -->
                <div class="permissions-info">
                    <div class="permissions-title">
                        <i class="fas fa-info-circle @(isArabic ? "ms-1" : "me-1")"></i>
                        @(isArabic ? "ما يمكنك فعله بصلاحياتك الحالية:" : "What you can do with your current permissions:")
                    </div>
                    <ul class="permissions-list">
                        <li><i class="fas fa-check text-success"></i> @(isArabic ? "عرض السجلات المدنية" : "View civil records")</li>
                        <li><i class="fas fa-check text-success"></i> @(isArabic ? "البحث في البيانات" : "Search data")</li>
                        <li><i class="fas fa-check text-success"></i> @(isArabic ? "عرض تفاصيل السجلات" : "View record details")</li>
                    </ul>
                </div>

                <!-- Buttons -->
                <div class="btn-group">
                    <a href="/Civil" class="btn btn-primary">
                        <i class="fas fa-database"></i>
                        @(isArabic ? "عرض البيانات" : "View Data")
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline">
                        <i class="fas @(isArabic ? "fa-arrow-right" : "fa-arrow-left")"></i>
                        @(isArabic ? "العودة" : "Go Back")
                    </a>
                </div>

                <!-- Contact Admin -->
                <div class="contact-admin">
                    <p>@(isArabic ? "هل تحتاج إلى صلاحيات إضافية؟" : "Need additional permissions?")</p>
                    <a href="mailto:admin@example.com">
                        <i class="fas fa-envelope @(isArabic ? "ms-1" : "me-1")"></i>
                        @(isArabic ? "تواصل مع مسؤول النظام" : "Contact System Administrator")
                    </a>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <p class="copyright">
            &copy; @DateTime.Now.Year @(isArabic ? "نظام السجل المدني. جميع الحقوق محفوظة." : "Civil Registry System. All rights reserved.")
        </p>
    </div>
</body>
</html>
