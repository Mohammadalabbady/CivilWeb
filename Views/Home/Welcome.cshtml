@{
    var lang = Context.Request.Cookies["Language"] ?? "ar";
    var isArabic = lang == "ar";
    ViewData["Title"] = isArabic ? "مرحباً" : "Welcome";
    Layout = null;
    var userName = User.Identity?.Name ?? "";
    var displayName = userName.Contains("\\") ? userName.Split('\\').Last() : userName;
    var userInitial = !string.IsNullOrEmpty(displayName) ? displayName[0].ToString().ToUpper() : "U";
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(isArabic ? "مرحباً - نظام السجل المدني" : "Welcome - Civil Registry System")</title>
    @if (isArabic)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    }
    else
    {
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    }
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --secondary: #64748b;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #1e293b;
            --light: #f8fafc;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: @(isArabic ? "'Cairo'" : "'Inter'"), sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #1e293b 0%, #334155 50%, #1e293b 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        /* Animated background */
        body::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(79, 70, 229, 0.1) 0%, transparent 50%);
            animation: pulse 15s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* Floating shapes */
        .shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.1;
            animation: float 20s ease-in-out infinite;
        }

        .shape-1 {
            width: 400px;
            height: 400px;
            background: var(--primary);
            top: -100px;
            right: -100px;
            animation-delay: 0s;
        }

        .shape-2 {
            width: 300px;
            height: 300px;
            background: var(--success);
            bottom: -50px;
            left: -50px;
            animation-delay: -5s;
        }

        .shape-3 {
            width: 200px;
            height: 200px;
            background: var(--warning);
            top: 50%;
            left: 10%;
            animation-delay: -10s;
        }

        .shape-4 {
            width: 150px;
            height: 150px;
            background: var(--primary);
            bottom: 20%;
            right: 10%;
            animation-delay: -15s;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(10deg); }
        }

        .main-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 520px;
            animation: fadeInUp 0.8s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Logo */
        .logo {
            text-align: center;
            margin-bottom: 35px;
        }

        .logo-icon {
            width: 90px;
            height: 90px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            box-shadow: 0 15px 50px rgba(79, 70, 229, 0.5);
            animation: logoFloat 3s ease-in-out infinite;
        }

        @@keyframes logoFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .logo-icon i {
            font-size: 42px;
            color: white;
        }

        .logo h1 {
            color: white;
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }

        .logo p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1rem;
            margin: 8px 0 0;
        }

        /* Card */
        .card {
            background: white;
            border-radius: 28px;
            box-shadow: 0 30px 100px rgba(0, 0, 0, 0.35);
            overflow: hidden;
            border: none;
        }

        .card-body {
            padding: 45px;
        }

        /* Welcome Section */
        .welcome-section {
            text-align: center;
            margin-bottom: 35px;
        }

        .welcome-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, var(--success) 0%, #059669 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);
        }

        .welcome-icon i {
            font-size: 30px;
            color: white;
        }

        .welcome-section h2 {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 12px;
        }

        .welcome-section p {
            color: var(--secondary);
            font-size: 1rem;
            line-height: 1.7;
        }

        /* User Info */
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 20px;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-radius: 16px;
            margin-bottom: 30px;
        }

        .user-avatar {
            width: 55px;
            height: 55px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 700;
            color: white;
            box-shadow: 0 5px 15px rgba(79, 70, 229, 0.3);
            flex-shrink: 0;
        }

        .user-details {
            flex: 1;
            min-width: 0;
        }

        .user-name {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 3px;
        }

        .user-status {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85rem;
            color: var(--success);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: var(--success);
            border-radius: 50%;
            animation: blink 2s ease-in-out infinite;
        }

        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* Buttons */
        .btn {
            padding: 16px 32px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 14px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-decoration: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            box-shadow: 0 10px 30px rgba(79, 70, 229, 0.35);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(79, 70, 229, 0.45);
            color: white;
        }

        .btn-primary:active {
            transform: translateY(-1px);
        }

        .btn-block {
            width: 100%;
        }

        .btn i {
            font-size: 1.2rem;
        }

        /* Language Toggle */
        .language-toggle {
            position: absolute;
            top: 20px;
            @(isArabic ? "left" : "right"): 20px;
            z-index: 100;
        }

        .lang-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .lang-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            color: white;
        }

        /* Copyright */
        .copyright {
            text-align: center;
            margin-top: 30px;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.85rem;
        }

        /* Responsive */
        @@media (max-width: 480px) {
            .card-body {
                padding: 30px 25px;
            }

            .logo h1 {
                font-size: 1.5rem;
            }

            .welcome-section h2 {
                font-size: 1.4rem;
            }

            .btn {
                padding: 14px 24px;
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Language Toggle -->
    <div class="language-toggle">
        @if (isArabic)
        {
            <a href="/Language/SetLanguage?lang=en&returnUrl=/Home/Welcome" class="lang-btn">
                <i class="fas fa-globe"></i> English
            </a>
        }
        else
        {
            <a href="/Language/SetLanguage?lang=ar&returnUrl=/Home/Welcome" class="lang-btn">
                <i class="fas fa-globe"></i> العربية
            </a>
        }
    </div>

    <!-- Floating shapes -->
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
    <div class="shape shape-4"></div>

    <div class="main-container">
        <!-- Logo -->
        <div class="logo">
            <div class="logo-icon">
                <i class="fas fa-building-columns"></i>
            </div>
            <h1>@(isArabic ? "نظام السجل المدني" : "Civil Registry System")</h1>
            <p>@(isArabic ? "نظام إدارة السجلات المدنية" : "Registry Management System")</p>
        </div>

        <!-- Card -->
        <div class="card">
            <div class="card-body">
                <!-- Welcome Message -->
                <div class="welcome-section">
                    <div class="welcome-icon">
                        <i class="fas fa-hand-wave"></i>
                    </div>
                    <h2>@(isArabic ? "مرحباً بك في نظام السجل المدني" : "Welcome to Civil Registry System")</h2>
                    <p>@(isArabic ? "إدارة السجلات المدنية بكفاءة من خلال نظام الإدارة الشامل." : "Efficiently manage civil records through the comprehensive management system.")</p>
                </div>

                <!-- User Info -->
                <div class="user-info">
                    <div class="user-avatar">@userInitial</div>
                    <div class="user-details">
                        <div class="user-name">@displayName</div>
                        <div class="user-status">
                            <span class="status-dot"></span>
                            @(isArabic ? "متصل الآن" : "Connected")
                        </div>
                    </div>
                </div>

                <!-- Enter Button -->
                <a href="/Home/Dashboard" class="btn btn-primary btn-block">
                    @(isArabic ? "الدخول إلى النظام" : "Enter System")
                    <i class="fas fa-arrow-@(isArabic ? "left" : "right")"></i>
                </a>
            </div>
        </div>

        <!-- Copyright -->
        <p class="copyright">
            &copy; @DateTime.Now.Year @(isArabic ? "نظام السجل المدني. جميع الحقوق محفوظة." : "Civil Registry System. All rights reserved.")
        </p>
    </div>
</body>
</html>
