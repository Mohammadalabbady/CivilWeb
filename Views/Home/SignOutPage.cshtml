@{
    var lang = Context.Request.Cookies["Language"] ?? "ar";
    var isArabic = lang == "ar";
    ViewData["Title"] = isArabic ? "تسجيل الخروج" : "Sign Out";
    Layout = null;
    var userName = User.Identity?.Name ?? "";
    var displayName = userName.Contains("\\") ? userName.Split('\\').Last() : userName;
    var userInitial = !string.IsNullOrEmpty(displayName) ? displayName[0].ToString().ToUpper() : "U";
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(isArabic ? "تسجيل الخروج - نظام السجل المدني" : "Sign Out - Civil Registry System")</title>
    @if (isArabic)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    }
    else
    {
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    }
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --secondary: #64748b;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #1e293b;
            --light: #f8fafc;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: @(isArabic ? "'Cairo'" : "'Inter'"), sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #1e293b 0%, #334155 50%, #1e293b 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        /* Animated background */
        body::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(79, 70, 229, 0.1) 0%, transparent 50%);
            animation: pulse 15s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* Floating shapes */
        .shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.1;
            animation: float 20s ease-in-out infinite;
        }

        .shape-1 {
            width: 400px;
            height: 400px;
            background: var(--primary);
            top: -100px;
            right: -100px;
            animation-delay: 0s;
        }

        .shape-2 {
            width: 300px;
            height: 300px;
            background: var(--warning);
            bottom: -50px;
            left: -50px;
            animation-delay: -5s;
        }

        .shape-3 {
            width: 200px;
            height: 200px;
            background: var(--success);
            top: 50%;
            left: 10%;
            animation-delay: -10s;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(10deg); }
        }

        .main-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 480px;
        }

        /* Logo */
        .logo {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            box-shadow: 0 10px 40px rgba(79, 70, 229, 0.4);
        }

        .logo-icon i {
            font-size: 32px;
            color: white;
        }

        .logo h1 {
            color: white;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .logo p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
            margin: 5px 0 0;
        }

        /* Card */
        .card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            border: none;
        }

        .card-body {
            padding: 40px;
        }

        /* User Info */
        .user-info {
            text-align: center;
            padding: 30px 20px;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-radius: 16px;
            margin-bottom: 30px;
        }

        .user-avatar {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 32px;
            font-weight: 700;
            color: white;
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.3);
        }

        .user-name {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 5px;
        }

        .user-domain {
            font-size: 0.875rem;
            color: var(--secondary);
        }

        /* Steps */
        .step {
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .step.active {
            display: block;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Message */
        .message {
            text-align: center;
            margin-bottom: 30px;
        }

        .message h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 10px;
        }

        .message p {
            color: var(--secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        /* Buttons */
        .btn {
            padding: 14px 28px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 35px rgba(79, 70, 229, 0.4);
        }

        .btn-warning {
            background: linear-gradient(135deg, var(--warning) 0%, #d97706 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(245, 158, 11, 0.3);
        }

        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 35px rgba(245, 158, 11, 0.4);
        }

        .btn-outline {
            background: transparent;
            color: var(--secondary);
            border: 2px solid #e2e8f0;
        }

        .btn-outline:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
        }

        .btn-block {
            width: 100%;
        }

        .btn-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-group .btn {
            flex: 1;
            min-width: 140px;
        }

        /* Loading */
        .loading-spinner {
            text-align: center;
            padding: 40px 20px;
        }

        .spinner {
            width: 60px;
            height: 60px;
            border: 4px solid #f1f5f9;
            border-top-color: var(--warning);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        .loading-text {
            color: var(--secondary);
            font-size: 1rem;
        }

        /* Success */
        .success-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--success) 0%, #059669 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            animation: scaleIn 0.5s ease;
        }

        .success-icon i {
            font-size: 36px;
            color: white;
        }

        @@keyframes scaleIn {
            from { transform: scale(0); }
            to { transform: scale(1); }
        }

        /* Footer */
        .footer-text {
            text-align: center;
            margin-top: 25px;
            padding-top: 25px;
            border-top: 1px solid #e2e8f0;
        }

        .footer-text p {
            color: var(--secondary);
            font-size: 0.85rem;
        }

        .footer-text a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
        }

        .footer-text a:hover {
            text-decoration: underline;
        }

        /* Copyright */
        .copyright {
            text-align: center;
            margin-top: 30px;
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <!-- Floating shapes -->
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>

    <div class="main-container">
        <!-- Logo -->
        <div class="logo">
            <div class="logo-icon">
                <i class="fas fa-building-columns"></i>
            </div>
            <h1>@(isArabic ? "نظام السجل المدني" : "Civil Registry System")</h1>
            <p>@(isArabic ? "نظام إدارة السجلات المدنية" : "Registry Management System")</p>
        </div>

        <!-- Card -->
        <div class="card">
            <div class="card-body">
                <!-- Step 1: Confirm Sign Out -->
                <div class="step active" id="step1">
                    <div class="user-info">
                        <div class="user-avatar">@userInitial</div>
                        <div class="user-name">@displayName</div>
                        <div class="user-domain">@userName</div>
                    </div>

                    <div class="message">
                        <h2>@(isArabic ? "تسجيل الخروج" : "Sign Out")</h2>
                        <p>@(isArabic ? "هل تريد تسجيل الخروج من حسابك؟ ستحتاج إلى إدخال بيانات الاعتماد مرة أخرى للوصول إلى النظام." : "Do you want to sign out of your account? You'll need to enter credentials again to access the system.")</p>
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-warning" id="signOutBtn">
                            <i class="fas fa-sign-out-alt"></i>
                            @(isArabic ? "تسجيل الخروج" : "Sign Out")
                        </button>
                        <a href="/" class="btn btn-outline">
                            <i class="fas fa-times"></i>
                            @(isArabic ? "إلغاء" : "Cancel")
                        </a>
                    </div>

                    <div class="footer-text">
                        <p>@(isArabic ? "أو يمكنك " : "Or you can ")
                            <a href="/" >@(isArabic ? "العودة للصفحة الرئيسية" : "return to homepage")</a>
                        </p>
                    </div>
                </div>

                <!-- Step 2: Loading -->
                <div class="step" id="step2">
                    <div class="loading-spinner">
                        <div class="spinner"></div>
                        <p class="loading-text" id="loadingText">@(isArabic ? "جاري تسجيل الخروج..." : "Signing out...")</p>
                    </div>
                </div>

                <!-- Step 3: Success -->
                <div class="step" id="step3">
                    <div class="text-center">
                        <div class="success-icon">
                            <i class="fas fa-check"></i>
                        </div>

                        <div class="message">
                            <h2>@(isArabic ? "تم تسجيل الخروج بنجاح" : "Signed Out Successfully")</h2>
                            <p>@(isArabic ? "تم تسجيل خروجك من النظام. انقر على الزر أدناه لتسجيل الدخول بحساب آخر." : "You have been signed out. Click the button below to sign in with a different account.")</p>
                        </div>

                        <a href="/" class="btn btn-primary btn-block" id="loginBtn">
                            <i class="fas fa-sign-in-alt"></i>
                            @(isArabic ? "تسجيل الدخول" : "Sign In")
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <p class="copyright">
            &copy; @DateTime.Now.Year @(isArabic ? "نظام السجل المدني. جميع الحقوق محفوظة." : "Civil Registry System. All rights reserved.")
        </p>
    </div>

    <script>
        const isArabic = @(isArabic ? "true" : "false");

        function showStep(stepNum) {
            document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
            document.getElementById('step' + stepNum).classList.add('active');
        }

        document.getElementById('signOutBtn').addEventListener('click', function() {
            showStep(2);

            // Try to clear credentials
            try {
                var xhr = new XMLHttpRequest();
                xhr.open('GET', '/Home/SignOut', true, 'logout', 'logout');
                xhr.send();
            } catch(e) {}

            fetch('/Home/SignOut', {
                method: 'GET',
                credentials: 'same-origin',
                headers: { 'Authorization': 'Basic ' + btoa('logout:logout') }
            }).catch(() => {});

            setTimeout(function() {
                document.getElementById('loadingText').textContent =
                    isArabic ? "جاري مسح بيانات الجلسة..." : "Clearing session data...";
            }, 800);

            setTimeout(function() {
                try {
                    document.cookie.split(";").forEach(function(c) {
                        document.cookie = c.replace(/^ +/, "").replace(/=.*/, "=;expires=" + new Date().toUTCString() + ";path=/");
                    });
                    localStorage.clear();
                    sessionStorage.clear();
                } catch(e) {}
            }, 1200);

            setTimeout(function() {
                showStep(3);
            }, 2000);
        });

        document.getElementById('loginBtn')?.addEventListener('click', function(e) {
            e.preventDefault();
            if (document.execCommand) {
                try { document.execCommand('ClearAuthenticationCache'); } catch(err) {}
            }
            window.location.href = '/';
        });
    </script>
</body>
</html>
